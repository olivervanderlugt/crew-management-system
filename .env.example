# Template for .env.local (copy ONCE, then edit .env.local directly).
# There is a single env file at the repo ROOT. The web app loads it via
# apps/web/next.config.ts; the CLI/seed scripts read it from here too.
#
# Supabase — get these from https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Supabase CLI — for running migrations
# Get from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=<access-token>
SUPABASE_DB_PASSWORD=<database-password>

# AI features (optional — leave empty to disable AI UI, no cost incurred)
# Anthropic key: https://console.anthropic.com/account/keys
AI_API_KEY=

# ─── Feature flags (Phase 2) ──────────────────────────────────
# Keep values free of inline comments — the loader treats everything
# after "=" as the value.
# NEXT_PUBLIC_CREW_PORTAL_ENABLED: Phase 2 crew self-service portal
NEXT_PUBLIC_CREW_PORTAL_ENABLED=false
# NEXT_PUBLIC_NOTIFICATIONS_ENABLED: Phase 2 WhatsApp/email notifications
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false
# WhatsApp-dispatch (Meta Cloud API). De outbox-drain (/api/cron/dispatch)
# verstuurt ALLEEN als NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true ÉN deze twee gezet
# zijn — anders wordt er niets verstuurd (fail-closed).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optioneel: Graph API-versie (standaard v20.0) en een goedgekeurde template-naam
# voor koude uitgaande berichten (buiten het 24u-venster). Leeg = platte tekst.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
# NEXT_PUBLIC_TIME_TRACKING: urenregistratie op toewijzingen (klok in/uit,
# pauze, akkoord) + de Uren-pagina en payroll-CSV-export (migratie 0013).
# Pas eerst de migratie toe; "false" verbergt het menu-item en blokkeert
# /api/payroll/export.
NEXT_PUBLIC_TIME_TRACKING=false
# NEXT_PUBLIC_RECURRENCE_GROUPS: herhalende events krijgen bij aanmaken een
# gedeeld recurrence_group_id zodat een serie bij elkaar hoort (migratie 0011).
# "false" = events worden los aangemaakt, precies als voorheen.
NEXT_PUBLIC_RECURRENCE_GROUPS=false
# NEXT_PUBLIC_CREW_SECOND_ADDRESS: tweede (bv. studenten-)adres per crewlid op
# de crew-formulieren, de kaart en bij geocoding (migratie 0012).
NEXT_PUBLIC_CREW_SECOND_ADDRESS=false
# NEXT_PUBLIC_CALCOM_URL: basis-URL van je Cal.com-boekingspagina, bv.
# https://cal.com/jouw-team/intake. Geen migratie nodig. Leeg = de knop
# "Intake plannen" bij prospects blijft uitgeschakeld.
NEXT_PUBLIC_CALCOM_URL=

# ─── Automatisering ───────────────────────────────────────────
# AUTO_OCCUPANCY: event springt automatisch naar Bevestigd zodra genoeg crew
# bevestigd is, en terug naar Gepland bij uitval. Aan tenzij expliciet "false".
AUTO_OCCUPANCY=true
# AUTO_CHECKIN: confirmed crew automatisch op checked_in zetten ná shift-einde
# (via /api/cron/auto-checkin). Aan tenzij "false".
AUTO_CHECKIN=true
# AUTO_CHECKIN_LOOKBACK_HOURS: hoe ver terug auto-checkin events meeneemt (uur).
AUTO_CHECKIN_LOOKBACK_HOURS=48
# CRON_SECRET: bearer-token waarmee een scheduler (Vercel Cron / GitHub Actions /
# curl) de /api/cron/* endpoints mag aanroepen. Alleen als Authorization-header;
# de ?key=-variant is verwijderd omdat die het geheim in logs achterlaat. Leeg = alleen handmatig door een
# ingelogde beheerder. Genereer iets willekeurigs, bv. `openssl rand -hex 32`.
CRON_SECRET=
# REMINDER_LEAD_DAYS: hoeveel dagen vóór een event herinneringen in de wachtrij
# gaan. Komma-lijst mag, bv. "7,3,1". Standaard "3".
REMINDER_LEAD_DAYS=3
# DOCUMENT_EXPIRY_WARN_DAYS: hoeveel dagen vóór een certificaat verloopt er een
# signaal/herinnering komt (via /api/cron/document-expiry). Standaard 30.
DOCUMENT_EXPIRY_WARN_DAYS=30
# NEXT_PUBLIC_COSTING: marge & loonkosten per event tonen (crew.hourly_cost +
# events.charge_rate, migratie 0015). Pas eerst de migratie toe; "true" toont de
# margekaart op events + tariefvelden op event/crew bewerken.
NEXT_PUBLIC_COSTING=false
# NEXT_PUBLIC_APP_URL: publieke basis-URL (bv. https://planning.example.com)
# voor 1-tik-bevestigen deep links in herinneringen. Leeg = geen link in bericht.
NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_SITE_URL: geen feature flag maar de publieke basis-URL van de app
# (bv. https://planning.example.com). Wordt gebruikt om de redirect-URL van de
# magic link voor het crew-portaal te bouwen, en als terugval voor
# NEXT_PUBLIC_APP_URL in deep links. Leeg = de code valt terug op de
# request-headers (origin/host), wat achter een proxy of bij mail-links de
# verkeerde URL kan opleveren — zet dit dus in elke echte deployment.
NEXT_PUBLIC_SITE_URL=
