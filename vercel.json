{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm turbo run build --filter=@crewops/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 8 * * *" },
    { "path": "/api/cron/auto-checkin", "schedule": "0 * * * *" },
    { "path": "/api/cron/availability-reminder", "schedule": "0 9 25 * *" },
    { "path": "/api/cron/document-expiry", "schedule": "0 7 * * 1" },
    { "path": "/api/cron/dispatch", "schedule": "*/10 * * * *" }
  ]
}
