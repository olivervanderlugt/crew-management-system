# Dependencies
node_modules/
.pnpm-store/

# Environment files — NEVER COMMIT CREDENTIALS
# The trailing-glob lines catch backups and scratch copies (.env.local.bak,
# .env.local.2026-08-19) that the narrower patterns let through.
.env
.env.local
.env.*.local
.env.production
.env.*
!.env.example

# Reference data — contains personal data (names, phones) — NEVER COMMIT
_reference/

# Build outputs
.next/
.turbo/
dist/
out/
build/
.expo/

# Supabase local
.supabase/
supabase/.temp/

# Cache
.cache/
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Playwright artifacts
test-results/
playwright-report/
.playwright/

# PWA service worker (generated by @serwist/next on build — anywhere in the tree)
**/public/sw.js
**/public/sw.js.map

# Claude Code local session settings
.claude/

# Supabase CLI local config — generated, and it carries local-only auth
# settings (open signup, no email confirmation) that must never be pushed
# to a hosted project with `supabase config push`.
supabase/config.toml
